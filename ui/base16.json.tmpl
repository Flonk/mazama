{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "{{.base05}}",
    "margin": 2
  },
  "block_quote": {
    "color": "{{.base04}}",
    "italic": true,
    "indent": 2
  },
  "paragraph": {},
  "list": {
    "color": "{{.base05}}",
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "{{.base08}}",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "{{.base00}}",
    "background_color": "{{.base0D}}",
    "bold": true
  },
  "h2": { "prefix": "## " },
  "h3": { "prefix": "### " },
  "h4": { "prefix": "#### " },
  "h5": { "prefix": "##### " },
  "h6": { "prefix": "###### " },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "color": "{{.base0E}}", "italic": true },
  "strong": { "color": "{{.base09}}", "bold": true },
  "hr": { "color": "{{.base03}}", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". ", "color": "{{.base09}}" },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "{{.base0C}}", "underline": true },
  "link_text": { "color": "{{.base0D}}" },
  "image": { "color": "{{.base0C}}", "underline": true },
  "image_text": { "color": "{{.base0D}}", "format": "Image: {{"{{"}}.text{{"}}"}} →" },
  "code": { "color": "{{.base0B}}", "background_color": "{{.base01}}" },
  "code_block": {
    "color": "{{.base05}}",
    "margin": 2,
    "chroma": {
      "text": { "color": "{{.base05}}" },
      "error": { "color": "{{.base00}}", "background_color": "{{.base08}}" },
      "comment": { "color": "{{.base03}}", "italic": true },
      "comment_preproc": { "color": "{{.base0E}}" },
      "keyword": { "color": "{{.base0E}}" },
      "keyword_reserved": { "color": "{{.base0E}}" },
      "keyword_namespace": { "color": "{{.base0E}}" },
      "keyword_type": { "color": "{{.base0A}}" },
      "operator": { "color": "{{.base0C}}" },
      "punctuation": { "color": "{{.base05}}" },
      "name": { "color": "{{.base08}}" },
      "name_builtin": { "color": "{{.base0A}}" },
      "name_tag": { "color": "{{.base08}}" },
      "name_attribute": { "color": "{{.base09}}" },
      "name_class": { "color": "{{.base0A}}" },
      "name_constant": { "color": "{{.base09}}" },
      "name_decorator": { "color": "{{.base0D}}" },
      "name_exception": { "color": "{{.base0F}}" },
      "name_function": { "color": "{{.base0D}}" },
      "name_other": {},
      "literal": {},
      "literal_number": { "color": "{{.base09}}" },
      "literal_date": {},
      "literal_string": { "color": "{{.base0B}}" },
      "literal_string_escape": { "color": "{{.base0C}}" },
      "generic_deleted": { "color": "{{.base08}}" },
      "generic_emph": { "color": "{{.base0E}}", "italic": true },
      "generic_inserted": { "color": "{{.base0B}}" },
      "generic_strong": { "color": "{{.base09}}", "bold": true },
      "generic_subheading": { "color": "{{.base08}}" },
      "background": { "background_color": "{{.base00}}" }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
